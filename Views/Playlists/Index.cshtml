@model MoodPlaylistGenerator.ViewModels.PlaylistListViewModel
@{
    ViewData["Title"] = "My Playlists";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="gradient-text display-5 mb-2">🎧 My Playlists</h1>
        <p class="text-muted mb-0">Manage and explore your personalized music collections</p>
    </div>
    <a href="@Url.Action("Generate")" class="btn btn-primary">
        <i class="fas fa-magic me-2"></i> Generate New Playlist
    </a>
</div>

<!-- Filter by Mood -->
<div class="card mb-5" style="border: 2px solid var(--primary-purple); background: linear-gradient(135deg, rgba(107, 70, 193, 0.05) 0%, rgba(236, 72, 153, 0.05) 100%);">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            <i class="fas fa-filter me-2" style="color: var(--primary-purple);"></i>
            <h5 class="mb-0" style="color: var(--primary-purple);">Filter by Mood</h5>
        </div>
        <form method="get" class="row g-3">
            <div class="col-md-8">
                <select class="form-select" id="moodId" name="moodId" onchange="this.form.submit()">
                    <option value="">🎵 All Moods</option>
                    @foreach (var mood in Model.Moods)
                    {
                        <option value="@mood.Id" selected="@(Model.FilterMoodId == mood.Id)" 
                                style="color: @mood.Color;">@mood.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end gap-2">
                @if (Model.FilterMoodId.HasValue)
                {
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Clear Filter
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Playlists List -->
@if (Model.Playlists.Any())
{
    <div class="row">
        @foreach (var playlist in Model.Playlists)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 playlist-card" style="background: linear-gradient(145deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.8) 100%); border-left: 6px solid @playlist.Mood.Color;">
                    <!-- Card Header with Gradient -->
                    <div class="card-header border-0" style="background: linear-gradient(135deg, @playlist.Mood.Color 0%, rgba(@playlist.Mood.Color, 0.7) 100%); border-radius: 16px 16px 0 0; padding: 1rem 1.5rem;">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0 text-white fw-bold">
                                <i class="fas fa-list-music me-2"></i>@playlist.Name
                            </h5>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light btn-outline-light dropdown-toggle" type="button" 
                                        data-bs-toggle="dropdown" style="background: rgba(255,255,255,0.2); border-color: rgba(255,255,255,0.3);">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Details", new { id = playlist.Id })">
                                            <i class="fas fa-eye me-2 text-primary"></i>View Details
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" action="@Url.Action("Delete", new { id = playlist.Id })" 
                                              style="display: inline;" 
                                              onsubmit="return confirm('Are you sure you want to delete this playlist?');">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fas fa-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <!-- Mood Badge -->
                        <div class="mb-3">
                            <span class="badge" style="background: linear-gradient(135deg, @playlist.Mood.Color 0%, rgba(@playlist.Mood.Color, 0.8) 100%); color: white; font-size: 0.85rem; padding: 0.6rem 1.2rem;">
                                <i class="fas fa-heart me-1"></i>@playlist.Mood.Name
                            </span>
                        </div>

                        <!-- Stats Section -->
                        <div class="row text-center mb-3">
                            <div class="col-6">
                                <div class="p-2 rounded" style="background: var(--gray-100);">
                                    <div class="h4 mb-1" style="color: var(--primary-purple);">@playlist.PlaylistSongs.Count</div>
                                    <small class="text-muted"><i class="fas fa-music me-1"></i>Songs</small>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded" style="background: var(--gray-100);">
                                    <div class="h4 mb-1" style="color: var(--accent-teal);">@((DateTime.Now - playlist.GeneratedAt).Days)</div>
                                    <small class="text-muted"><i class="fas fa-calendar me-1"></i>Days ago</small>
                                </div>
                            </div>
                        </div>

                        <!-- Creation Date -->
                        <p class="card-text text-muted mb-3 text-center">
                            <i class="fas fa-clock me-1"></i>
                            <small>Created on @playlist.GeneratedAt.ToString("MMM dd, yyyy")</small>
                        </p>

                        <!-- Action Button -->
                        <div class="mt-auto">
                            <a href="@Url.Action("Details", new { id = playlist.Id })" 
                               class="btn btn-outline-primary w-100" 
                               style="background: linear-gradient(135deg, transparent 0%, rgba(107, 70, 193, 0.05) 100%); border: 2px solid var(--primary-purple); font-weight: 600;">
                                <i class="fas fa-play me-2"></i> Listen Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Summary -->
    <div class="mt-4">
        <p class="text-muted">
            Showing @Model.Playlists.Count playlist@(Model.Playlists.Count == 1 ? "" : "s")
            @if (Model.FilterMoodId.HasValue)
            {
                var selectedMood = Model.Moods.FirstOrDefault(m => m.Id == Model.FilterMoodId.Value);
                if (selectedMood != null)
                {
                    <span>for mood: <strong style="color: @selectedMood.Color;">@selectedMood.Name</strong></span>
                }
            }
        </p>
    </div>
}
else
{
    <div class="text-center py-5">
        <div class="card" style="background: linear-gradient(135deg, var(--gray-50) 0%, rgba(107, 70, 193, 0.05) 100%); border: 2px dashed var(--gray-300); max-width: 500px; margin: 0 auto;">
            <div class="card-body py-5">
                <div class="mb-4">
                    <div class="rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-list-music fa-2x text-white"></i>
                    </div>
                </div>
                <h4 class="gradient-text mb-3">No playlists found</h4>
                @if (Model.FilterMoodId.HasValue)
                {
                    <p class="text-muted mb-4">Try selecting a different mood or clear the filter to see all your playlists.</p>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-3">
                        <i class="fas fa-times me-2"></i>Clear Filter
                    </a>
                }
                else
                {
                    <p class="text-muted mb-4">Ready to create your first musical journey? Let's generate a personalized playlist just for you!</p>
                }
                <a href="@Url.Action("Generate")" class="btn btn-primary">
                    <i class="fas fa-magic me-2"></i> Generate Your First Playlist
                </a>
            </div>
        </div>
    </div>
}
