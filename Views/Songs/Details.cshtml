@model MoodPlaylistGenerator.ViewModels.SongDetailViewModel
@{
    ViewData["Title"] = Model.Song.Title;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🎵 @Model.Song.Title</h2>
    <div class="btn-group">
        <a href="@Url.Action("Edit", new { id = Model.Song.Id })" class="btn btn-warning">
            <i class="fas fa-edit"></i> Edit
        </a>
        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Songs
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Song Information</h5>
                <table class="table table-borderless">
                    <tbody>
                        <tr>
                            <td><strong>Title:</strong></td>
                            <td>@Model.Song.Title</td>
                        </tr>
                        <tr>
                            <td><strong>Artist:</strong></td>
                            <td>@Model.Song.Artist</td>
                        </tr>
                        <tr>
                            <td><strong>YouTube URL:</strong></td>
                            <td>
                                <a href="@Model.Song.YouTubeUrl" target="_blank" class="text-decoration-none">
                                    🎬 Watch on YouTube
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Added:</strong></td>
                            <td>@Model.Song.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</td>
                        </tr>
                        <tr>
                            <td><strong>Moods:</strong></td>
                            <td>
                                @if (Model.AssignedMoods.Any())
                                {
                                    @foreach (var mood in Model.AssignedMoods)
                                    {
                                        <span class="badge rounded-pill me-2" 
                                              style="background-color: @mood.Color; color: white;">
                                            @mood.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">No moods assigned</span>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.YouTubeVideoId))
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">YouTube Preview</h5>
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.youtube.com/embed/@Model.YouTubeVideoId" 
                                title="YouTube video player" 
                                frameborder="0" 
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                                allowfullscreen>
                        </iframe>
                    </div>
                </div>
            </div>
        }

        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Actions</h5>
                <div class="d-grid gap-2">
                    <a href="@Url.Action("Edit", new { id = Model.Song.Id })" class="btn btn-warning">
                        <i class="fas fa-edit"></i> Edit Song
                    </a>
                    <a href="@Model.Song.YouTubeUrl" target="_blank" class="btn btn-outline-primary">
                        <i class="fab fa-youtube"></i> Watch on YouTube
                    </a>
                    <form method="post" action="@Url.Action("Delete", new { id = Model.Song.Id })" 
                          onsubmit="return confirm('Are you sure you want to delete this song? This action cannot be undone.');">
                        <button type="submit" class="btn btn-outline-danger w-100">
                            <i class="fas fa-trash"></i> Delete Song
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
